# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Data (never commit large datasets)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/splits/*
!data/splits/.gitkeep

# Training runs (checkpoints, logs - large, reproducible from training/ scripts)
training/runs/

# Model weights (large binaries, use Git LFS or releases instead)
models/weights/*.pt
models/weights/*.onnx
models/weights/*.engine
!models/weights/.gitkeep

# Outputs (generated artifacts, not source)
outputs/videos/*
!outputs/videos/.gitkeep
outputs/results/*
!outputs/results/.gitkeep
outputs/plots/*
!outputs/plots/.gitkeep
# ...except curated failure-case evidence images, which are small documentation
# assets referenced from README.md, not disposable run output
!outputs/plots/failure_cases/
!outputs/plots/failure_cases/*.jpg

# Environment / IDE
.env
.vscode/
.idea/
.claude/scheduled_tasks.lock  # session-runtime state, not project config

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
